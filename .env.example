# CognoDB / Neo4j-compatible Bolt endpoint (free c0 instance)
# Create one at https://console.cognodb.com/signup — no credit card needed.
#
# IMPORTANT: use the "bolt+ssc://" scheme. CognoDB issues its own CA
# certificates, so the default "bolt+s://" (public-CA validation) fails
# with ECONNRESET. "bolt+ssc" trusts the endpoint certificate on first use.
NEO4J_URI=bolt+ssc://<your-instance-id>.databases.cognodb.com
NEO4J_USER=cognodb
NEO4J_PASSWORD=<the-password-shown-once-at-creation>